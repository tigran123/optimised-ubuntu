# Desktop defaults for every account: the dconf system database "local",
# which /etc/dconf/profile/user puts under each user's own settings.
# Defaults, not locks: whatever a user sets wins. After editing: dconf update

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/Ravnina.jpg'
picture-uri-dark='file:///usr/share/backgrounds/Ravnina.jpg'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/Ravnina.jpg'

[org/gnome/desktop/interface]
accent-color='blue'
gtk-theme='Yaru-blue'
icon-theme='Yaru-blue'
enable-animations=false
# Every monitor at 100% instead of a scale guessed from its DPI, since
# Terminus is a bitmap font and smears at any other. A scale picked in
# Settings > Display is stored in ~/.config/monitors.xml and still wins.
scaling-factor=uint32 1

[org/gnome/desktop/privacy]
remember-recent-files=false

[org/gnome/desktop/search-providers]
disable-external=true

# No file indexing beyond the non-recursive look at the home directory.
[org/freedesktop/tracker/miner/files]
index-recursive-directories=@as []

[org/gnome/nautilus/preferences]
default-folder-viewer='list-view'

[org/gnome/nautilus/list-view]
default-zoom-level='small'

[org/gnome/shell]
favorite-apps=['org.gnome.Settings.desktop', 'google-chrome.desktop', 'terminator.desktop', 'org.gnome.Nautilus.desktop']

[org/gnome/shell/extensions/dash-to-dock]
dock-fixed=false
extend-height=false
show-mounts=false
show-mounts-network=false
show-mounts-only-mounted=true
show-trash=false

[org/gnome/shell/extensions/ding]
show-home=false

[org/gnome/settings-daemon/plugins/color]
night-light-enabled=true
night-light-schedule-automatic=false
night-light-schedule-from=18.0
night-light-temperature=uint32 3339

[org/gnome/desktop/peripherals/touchpad]
click-method='fingers'
natural-scroll=false

# Ctrl+F9 opens Terminator.
[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0]
binding='<Control>F9'
command='terminator'
name='Terminator'
